<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorPrimary"
            app:title="@string/app_name"
            app:titleTextColor="@android:color/white" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- RecyclerView scrolls below the AppBar; bottom padding clears footer + FAB -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_manuals"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="160dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        tools:listitem="@layout/item_manual" />

    <!-- Footer pinned to the bottom as a direct CoordinatorLayout child -->
    <LinearLayout
        android:id="@+id/footer_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="?attr/colorSurface"
        android:elevation="4dp"
        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/colorControlHighlight" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_buy_me_a_coffee"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:maxWidth="280dp"
            android:minWidth="200dp"
            android:text="@string/bmc_button_label"
            android:textColor="#000000"
            android:textStyle="bold"
            app:backgroundTint="#FFDD00"
            app:cornerRadius="8dp"
            app:strokeColor="#000000"
            app:strokeWidth="1.5dp" />

    </LinearLayout>

    <!-- FAB floats in the content area, above the footer (77dp) with 16dp clearance -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fab_download"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="93dp"
        android:text="@string/fab_download_label"
        app:icon="@android:drawable/stat_sys_download" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
