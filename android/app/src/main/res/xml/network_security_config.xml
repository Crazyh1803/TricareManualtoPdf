<?xml version="1.0" encoding="utf-8"?>
<network-security-config>

    <!-- The bundled DoD Root CA 3/5/6 anchors and the health.mil domain-config
         that used them are gone: manuals.health.mil was retired, and the app no
         longer contacts it. Content now comes from the project's static mirror
         on GitHub Pages, which presents a certificate chaining to a commercial
         CA already in Android's system store, so no extra trust anchors are
         needed. Cleartext stays disabled everywhere. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <!-- Keep user-installed CAs trusted so SSL-inspecting security
                 software and corporate proxies do not silently break every
                 connection, which is why this was added originally. -->
            <certificates src="user" />
        </trust-anchors>
    </base-config>

</network-security-config>
